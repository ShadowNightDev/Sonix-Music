{
  "name": "sonix-music",
  "version": "1.0.0",
  "description": "A beautiful desktop music player.",
  "author": "Sonix",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.sonix.music",
    "productName": "Sonix Music",
    "compression": "maximum",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "renderer/**/*",
      "node_modules/**/*",
      "bin/**/*"
    ],
    "asarUnpack": [
      "bin/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "renderer/assets/logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "${productName}-${version}-Setup.exe"
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.exe"
    }
  },
  "devDependencies": {
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "yt-dlp-wrap": "^2.3.12"
  }
}
